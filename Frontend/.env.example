# Copy to .env to connect the frontend to the live backend.
# Leave unset (or delete .env) to keep running on the built-in dummy-data layer.

VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Set the real public HTTPS origin before enabling production search indexing.
VITE_SITE_URL=https://www.mistymounts.pk
# Keep demo, staging and preview builds out of search. Production requires live API.
VITE_SEO_INDEXABLE=false
# Optional: allow GPTBot model-training crawling. Search discovery stays separate.
SEO_ALLOW_TRAINING=false
