# ── Core ────────────────────────────────────────────────────────────────────
MONGO_URI=your-mongodb-connection-string
JWT_SECRET=a-long-random-secret
PORT=5000
CLIENT_URL=http://localhost:5173

# Admin login (never commit real values)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── Cloudinary (image uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP (OTP + query replies) ───────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
SENDER_EMAIL=

# ── AI concierge (optional, FREE tier) ───────────────────────────────────────
# Get a free key at aistudio.google.com. Without it, the concierge & review
# summaries fall back to a keyword responder.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ── Web push (optional) ──────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# ── Online payments / escrow (optional) ──────────────────────────────────────
# Leave blank to keep the manual proof-upload flow. Fill in with your gateway
# (e.g. Safepay / PayFast) sandbox credentials to enable hosted checkout.
PAYMENT_PROVIDER=safepay
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CREATE_URL=
PAYMENT_CHECKOUT_URL=
