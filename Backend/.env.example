# ── Core ────────────────────────────────────────────────────────────────────
MONGO_URI=your-mongodb-connection-string
JWT_SECRET=a-long-random-secret
PORT=5000
CLIENT_URL=http://localhost:5173

# Admin login (never commit real values)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── Cloudinary (image uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP (OTP + query replies) ───────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
SENDER_EMAIL=

# ── AI concierge (optional, FREE tier) ───────────────────────────────────────
# Get a free key at aistudio.google.com. Without it, the concierge & review
# summaries fall back to a keyword responder.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ── Web push (optional) ──────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# ── Online payments / escrow (optional) ──────────────────────────────────────
# Leave PAYMENT_PROVIDER unset (or "manual") to keep the manual proof-upload
# flow. Set it to one of: jazzcash | easypaisa | safepay (generic JSON).
# Milestone escrow works regardless of provider (even manual): payment approval
# holds funds in escrow; they release to the partner when the traveller confirms.
# SERVER_URL is the public base URL of THIS backend (used to build the gateway
# return URL for redirect providers) — e.g. https://api.mistymounts.pk
PAYMENT_PROVIDER=

SERVER_URL=

# JazzCash (redirect / HTTP-POST page redirection). From your JazzCash merchant portal.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_POST_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/

# Easypaisa (Easypay hosted checkout). HASH_KEY must be a 16-char AES-128 key.
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_POST_URL=https://easypay.easypaisa.com.pk/easypay/Index.jsf

# Generic JSON gateway (Safepay / PayFast shaped) — server-to-server webhook.
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CREATE_URL=
PAYMENT_CHECKOUT_URL=
